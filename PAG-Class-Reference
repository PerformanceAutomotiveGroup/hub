<!-- INTERACTIVITY SCRIPT -->
<script>
function showToast(message) {
const toast = document.getElementById('sg-toast');
toast.innerText = message;
toast.classList.add('show');
setTimeout(() => {
toast.classList.remove('show');
}, 1800);
}

function copyValue(val, btnElement) {
navigator.clipboard.writeText(val).then(() => {
const originalText = btnElement.innerText;
btnElement.innerText = 'Copied!';
btnElement.classList.add('copied');
showToast(`Copied: "${val}"`);

setTimeout(() => {
btnElement.innerText = originalText;
btnElement.classList.remove('copied');
}, 1400);
});
}

function copySnippet(btnElement) {
const card = btnElement.closest('.sg-card');
const preview = card.querySelector('.sg-preview');
const cleanHtml = preview.innerHTML.trim();

navigator.clipboard.writeText(cleanHtml).then(() => {
const originalText = btnElement.innerText;
btnElement.innerText = 'Copied HTML!';
btnElement.classList.add('copied');
showToast('HTML structure copied to clipboard!');

setTimeout(() => {
btnElement.innerText = originalText;
btnElement.classList.remove('copied');
}, 1400);
});
}

function filterComponents() {
const query = document.getElementById('sg-search').value.toLowerCase();
const cards = document.querySelectorAll('.sg-card');

cards.forEach(card => {
const keywords = card.getAttribute('data-search') ? card.getAttribute('data-search').toLowerCase() : '';
const text = card.innerText.toLowerCase();

if (keywords.includes(query) || text.includes(query)) {
card.style.display = 'flex';
} else {
card.style.display = 'none';
}
});
}
</script>
